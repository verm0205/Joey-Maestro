<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ pageTitle }} Joey Vermeulen</title>
    <link rel="stylesheet" href="/css/stylesheet.css">
    {% block head %}{% endblock %}
</head>
<body>
<nav class="navbar" role="navigation" aria-label="Hoofd navigatie">
    <div class="nav-left">
        <img src="/img/joeypfp.jpg" alt="Profielfoto Joey Vermeulen" class="avatar">
        <span class="profile-name">Joey Vermeulen</span>
    </div>

    <ul class="nav-right" role="list">
        <li><a href="/" class="{{ request.path == '/' ? 'active' : '' }}">Home</a></li>
        <li><a href="/profiles" class="{{ request.path == '/profiles' ? 'active' : '' }}">Profile</a></li>
        <li><a href="/dashboard" class="{{ request.path == '/dashboard' ? 'active' : '' }}">Dashboard</a></li>
        <li><a href="/faq" class="{{ request.path == '/faq' ? 'active' : '' }}">FAQ</a></li>
        <li><a href="/blog" class="{{ request.path starts with '/blog' ? 'active' : '' }}">Blog</a></li>
        <li><a href="/tasks-api" class="{{ request.path == '/tasks-api' ? 'active' : '' }}">Tasks API</a></li>

        {% if currentUser is not null %}
            {% if currentUser.role == 'admin' %}
                <li><a href="/blog/manage" class="{{ request.path == '/blog/manage' ? 'active' : '' }}">Manage Blog</a></li>
            {% endif %}
            <li>
                <form method="POST" action="/logout" style="display:inline;">
                    <button type="submit" class="btn-nav-logout">Logout ({{ currentUser.name }})</button>
                </form>
            </li>
        {% else %}
            <li><a href="/login" class="{{ request.path == '/login' ? 'active' : '' }}">Login</a></li>
            <li><a href="/register" class="{{ request.path == '/register' ? 'active' : '' }}">Register</a></li>
        {% endif %}
    </ul>
</nav>

<main>
    {% block content %}{% endblock %}
</main>
</body>
</html>
