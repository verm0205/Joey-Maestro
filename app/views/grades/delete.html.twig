{% extends "partials/base.html.twig" %}
{% set pageTitle = "Vak verwijderen" %}

{% block content %}
<h1>Vak verwijderen</h1>

<p>Weet je zeker dat je <strong>{{ grade.course }} — {{ grade.toetsing }}</strong> wilt verwijderen?</p>

<form method="POST" action="/grades/{{ grade.id }}/delete">
    <button type="submit" style="background:#c0392b;color:#fff;padding:0.5rem 1rem;border:none;border-radius:4px;cursor:pointer;">
        Ja, verwijderen
    </button>
    <a href="/dashboard" style="margin-left:1rem;">Annuleren</a>
</form>
{% endblock %}
