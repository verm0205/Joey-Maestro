{% extends "partials/base.html.twig" %}
{% set pageTitle = "Vak verwijderen" %}

{% block content %}
    <div class="form-container" style="text-align: center;">
        <h1>Vak verwijderen</h1>

        <p style="margin-bottom: 24px; font-size: 15px;">
            Weet je zeker dat je <strong>{{ grade.course }} {{ grade.toetsing }}</strong> wilt verwijderen?<br>
            <span style="color: var(--muted); font-size: 13px;">Dit kan niet ongedaan worden gemaakt.</span>
        </p>

        <form method="POST" action="/grades/{{ grade.id }}/delete">
            <div class="form-actions">
                <a href="/dashboard" class="btn btn-secondary">Annuleren</a>
                <button type="submit" class="btn btn-danger" style="background-color: #c0392b; color: #fff;">Ja, verwijderen</button>
            </div>
        </form>
    </div>
{% endblock %}