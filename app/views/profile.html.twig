{% extends "partials/base.html.twig" %}
{% set pageTitle = "Profiel" %}

{% block content %}
    <h1>Profiel</h1>

    {% if session.get('user') %}
        <a href="/profile/edit" class="btn btn-primary">Profiel bewerken</a>
    {% endif %}

    <h2>Wie ben ik?</h2>
    <p>{{ profile.about_me }}</p>

    <h2>Persoonlijke Kenmerken & Skills</h2>
    <ul>
        <li><strong>Leergierig:</strong> {{ profile.eager_to_learn }}</li>
        <li><strong>Doorzettingsvermogen:</strong> {{ profile.perseverance }}</li>
        <li><strong>Teamspeler:</strong> {{ profile.team_player }}</li>
        <li><strong>Talen:</strong> {{ profile.languages }}</li>
    </ul>

    <h2>Contact / Links</h2>
    <ul>
        <li><strong>GitHub:</strong> <a href="https://{{ profile.github_url }}">{{ profile.github_url }}</a></li>
        <li><strong>Email:</strong> <a href="mailto:{{ profile.email }}">{{ profile.email }}</a></li>
    </ul>
{% endblock %}