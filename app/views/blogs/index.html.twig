{% extends "partials/base.html.twig" %}
{% set pageTitle = "Blog | " %}

{% block content %}
    <header>
        <h1>Blog</h1>
        <p>Thoughts, reflections, and updates from my studies at HZ University.</p>
    </header>

    {% if isAdmin %}
        <div style="margin-bottom: 1.5rem;">
            <a href="/blog/manage" class="btn btn-primary">⚙ Manage Posts</a>
        </div>
    {% endif %}

    {% if posts is empty %}
        <div class="alert alert-info">No posts published yet. Check back soon!</div>
    {% else %}
        <div class="blog-list">
            {% for post in posts %}
                <article class="blog-card">
                    <h2><a href="/blog/{{ post.id }}">{{ post.title }}</a></h2>
                    <p class="blog-meta">Published on {{ post.created_at|date('d F Y') }}</p>
                    <p class="blog-excerpt">{{ post.body|slice(0, 200) }}{% if post.body|length > 200 %}…{% endif %}</p>
                    <a href="/blog/{{ post.id }}" class="btn btn-outline btn-sm">Read more</a>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
