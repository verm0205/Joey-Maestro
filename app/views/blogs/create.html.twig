{% extends "partials/base.html.twig" %}
{% set pageTitle = "New Post | " %}

{% block content %}
    <div class="form-container">
        <h1>New Blog Post</h1>

        <form method="POST" action="/blog">
            <div class="form-group">
                <label for="title">Title</label>
                <input
                        type="text"
                        name="title"
                        id="title"
                        class="form-control {% if errors is defined and errors.title is defined %}input-error{% endif %}"
                        value="{{ post is defined ? post.title : '' }}"
                        maxlength="255"
                        placeholder="Enter a descriptive title…"
                        autofocus
                >
                {% if errors is defined and errors.title is defined %}
                    <span class="error" role="alert">{{ errors.title }}</span>
                {% endif %}
            </div>

            <div class="form-group">
                <label for="body">Content</label>
                <textarea
                        name="body"
                        id="body"
                        class="form-control {% if errors is defined and errors.body is defined %}input-error{% endif %}"
                        rows="12"
                        placeholder="Write your post here…"
                >{{ post is defined ? post.body : '' }}</textarea>
                {% if errors is defined and errors.body is defined %}
                    <span class="error" role="alert">{{ errors.body }}</span>
                {% endif %}
            </div>

            <div class="form-group">
                <label for="status">Status</label>
                <select name="status" id="status" class="form-control">
                    <option value="draft"     {{ (post is defined and post.status == 'draft')     ? 'selected' : '' }}>Draft</option>
                    <option value="published" {{ (post is defined and post.status == 'published') ? 'selected' : '' }}>Published</option>
                    <option value="archived"  {{ (post is defined and post.status == 'archived')  ? 'selected' : '' }}>Archived</option>
                </select>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Post</button>
                <a href="/blog/manage" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
{% endblock %}
