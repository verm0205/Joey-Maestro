{% extends "partials/base.html.twig" %}
{% set pageTitle = post.title ~ " | " %}

{% block content %}
    <article class="blog-post">
        <header>
            <h1>{{ post.title }}</h1>
            <p class="blog-meta">Published on {{ post.created_at|date('d F Y') }}</p>
        </header>

        <div class="blog-body">
            {{ post.body|nl2br }}
        </div>

        <div style="margin-top: 2rem;">
            <a href="/blog" class="btn btn-secondary">← Back to Blog</a>
        </div>
    </article>
{% endblock %}
