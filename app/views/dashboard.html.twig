{% extends "partials/base.html.twig" %}

{% set pageTitle = "Dashboard — Studievoortgang" %}

{% set statusLabels = {0: 'In afwachting', 1: 'Behaald', 2: 'Opnieuw'} %}
{% set statusClasses = {0: 'status-pending', 1: 'status-complete', 2: 'status-failed'} %}

{% block content %}
    <header>
        <h1>Studievoortgang — Jaar 1</h1>
        <p>Overzicht van alle eerstejaars te behalen EC's en resultaten per component.</p>
    </header>

    <div style="margin-bottom: 1rem;">
        <a href="/grades/create" class="btn-primary">+ Nieuw vak toevoegen</a>
    </div>

    <section class="dashboard">
        <table>
            <thead>
            <tr>
                <th>Quarter</th>
                <th>Course</th>
                <th>EC</th>
                <th>Toetsing</th>
                <th>Cijfer</th>
                <th>Status</th>
                <th>Acties</th>
            </tr>
            </thead>
            <tbody>
            {% for grade in grades %}
                <tr class="{{ statusClasses[grade.status] }}">
                    <td>{{ grade.quarter }}</td>
                    <td>{{ grade.course }}</td>
                    <td>{{ grade.ec }}</td>
                    <td>{{ grade.toetsing }}</td>
                    <td>{{ grade.cijfer is not null ? grade.cijfer : '—' }}</td>
                    <td>{{ statusLabels[grade.status] }}</td>
                    <td>
                        <a href="/grades/{{ grade.id }}/edit">Bewerken</a>
                        &nbsp;
                        <a href="/grades/{{ grade.id }}/delete" style="color:#c0392b;">Verwijderen</a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" style="text-align:center;color:#888;">Geen vakken gevonden.</td></tr>
            {% endfor %}
            </tbody>
            <tfoot>
            <tr>
                <td colspan="3"><strong>Totaal behaalde EC's</strong></td>
                <td colspan="4" class="nbsa">{{ earnedEc }} / 60 EC — NBSA grens: 45 EC</td>
            </tr>
            </tfoot>
        </table>

        <p style="margin-top:12px"><strong>Legenda:</strong>
            <span class="status-complete" style="padding:2px 8px;border-radius:4px;margin-right:5px;">Behaald</span>
            <span class="status-pending"  style="padding:2px 8px;border-radius:4px;margin-right:5px;">In afwachting</span>
            <span class="status-failed"   style="padding:2px 8px;border-radius:4px;">Opnieuw</span>
        </p>
    </section>
{% endblock %}
