{% extends "partials/base.html.twig" %}
{% set pageTitle = "Profiel bewerken" %}

{% block content %}
    <div class="form-container">
        <h1>Profiel bewerken</h1>

        <form method="POST" action="/profile/edit">
            <div class="form-group">
                <label for="about_me">Wie ben ik?</label>
                <textarea name="about_me" id="about_me" class="form-control" rows="5">{{ profile.about_me }}</textarea>
            </div>

            <div class="form-group">
                <label for="eager_to_learn">Leergierig</label>
                <input type="text" name="eager_to_learn" id="eager_to_learn" class="form-control" value="{{ profile.eager_to_learn }}">
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Opslaan</button>
                <a href="/profile" class="btn btn-secondary">Annuleren</a>
            </div>
        </form>
    </div>
{% endblock %}