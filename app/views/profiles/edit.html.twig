{% extends "partials/base.html.twig" %}
{% set pageTitle = "Profiel bewerken" %}

{% block content %}
    <div class="form-container">
        <h1>Profiel bewerken</h1>

        <form method="POST" action="/profile/edit">
            <div class="form-group">
                <label for="about_me">Wie ben ik?</label>
                <textarea name="about_me" id="about_me" class="form-control" rows="5">{{ profile.about_me }}</textarea>
            </div>

            <div class="form-group">
                <label for="eager_to_learn">Leergierig</label>
                <input type="text" name="eager_to_learn" id="eager_to_learn" class="form-control" value="{{ profile.eager_to_learn }}">
            </div>

            <div class="form-group">
                <label for="perseverance">Doorzettingsvermogen</label>
                <input type="text" name="perseverance" id="perseverance" class="form-control" value="{{ profile.perseverance }}">
            </div>

            <div class="form-group">
                <label for="team_player">Teamspeler</label>
                <input type="text" name="team_player" id="team_player" class="form-control" value="{{ profile.team_player }}">
            </div>

            <div class="form-group">
                <label for="languages">Talen</label>
                <input type="text" name="languages" id="languages" class="form-control" value="{{ profile.languages }}">
            </div>

            <div class="form-group">
                <label for="github_url">GitHub URL</label>
                <input type="text" name="github_url" id="github_url" class="form-control" value="{{ profile.github_url }}">
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" name="email" id="email" class="form-control" value="{{ profile.email }}">
            </div>

            <div class="form-actions" style="margin-top: 20px;">
                <button type="submit" class="btn btn-primary">Opslaan</button>
                <a href="/profile" class="btn btn-secondary">Annuleren</a>
            </div>
        </form>
    </div>
{% endblock %}