{
  "name": "joey/maestro",
  "description": "Joey Maestro portfolio application",
  "type": "framework",
  "autoload": {
    "psr-4": {
      "Framework\\": "src/",
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "twig/twig": "^3.21"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4",
    "deptrac/deptrac": "^4.5",
    "phpunit/phpunit": "^13.2"
  }
}
